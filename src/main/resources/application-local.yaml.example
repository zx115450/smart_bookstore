# 本地敏感配置模板（正式文件 application-local.yaml 已 gitignore）
#
# 使用方法：
#   cp src/main/resources/application-local.yaml.example src/main/resources/application-local.yaml
# 启动：mvn spring-boot:run -Dspring-boot.run.profiles=local
#
# 两种常见模式（二选一）：
#   A. 本机 docker compose（smart_bookstore/docker-compose.yml）
#   B. 远程中间件 192.168.150.104（见 ZCODE/ops/remote-104/README.md）← 当前联调推荐

# =============================================================================
# B. 远程中间件 192.168.150.104（本机只跑书城 8081）
# =============================================================================
spring:
  mail:
    host: smtp.qq.com
    port: 465
    username: your-email@qq.com
    password: your-smtp-authorization-code
  datasource:
    url: jdbc:mysql://192.168.150.104:3306/smart_bookstore?useSSL=false&serverTimezone=UTC&useUnicode=true&characterEncoding=UTF-8&allowPublicKeyRetrieval=true&allowMultiQueries=true&rewriteBatchedStatements=true&useServerPrepStmts=true&cachePrepStmts=true&prepStmtCacheSize=250&prepStmtCacheSqlLimit=2048
    username: root
    password: 1234
  data:
    redis:
      host: 192.168.150.104
      port: 6379
      password:
  rabbitmq:
    host: 192.168.150.104
    port: 5672
    username: root
    password: 1234
    virtual-host: bookstore
  ai:
    openai:
      chat:
        api-key: your-deepseek-api-key
      embedding:
        api-key: your-dashscope-api-key
    vectorstore:
      milvus:
        client:
          host: 192.168.150.104
          port: 19530

ai:
  rag:
    enabled: true

bookstore:
  redis:
    mode: standalone
    password:
    standalone:
      host: 192.168.150.104
      port: 6379
  # 线上阅读板块（B 阶段）联调媒资时使用；开发期可 mock: true
  # media:
  #   lite-vod:
  #     enabled: true
  #     mock: true
  #     base-url: http://127.0.0.1:8080
  #     internal-token: ${BOOKSTORE_MEDIA_TOKEN:}
  #     connect-timeout-ms: 3000
  #     read-timeout-ms: 10000

auth:
  jwt:
    secret: LocalDevOnlyChangeMeUseALongRandomSecretKey32B+
  oauth:
    qq:
      app-id: your-qq-app-id
      app-key: your-qq-app-key
      redirect-uri: http://localhost:8081/api/auth/oauth/qq/callback
      frontend-success-url: http://localhost:5173/oauth/qq/success
      frontend-error-url: http://localhost:5173/oauth/qq/error

# =============================================================================
# A. 本机 docker compose（取消注释并注释掉上方 B 段即可）
# =============================================================================
# spring:
#   datasource:
#     url: jdbc:mysql://localhost:3306/smart_bookstore?useSSL=false&serverTimezone=UTC&useUnicode=true&characterEncoding=UTF-8&allowPublicKeyRetrieval=true
#     username: root
#     password: root
#   data:
#     redis:
#       host: localhost
#       port: 6379
#   rabbitmq:
#     host: localhost
#     port: 5672
#     username: guest
#     password: guest
#     virtual-host: /
# ai:
#   rag:
#     enabled: false   # 本机需 docker compose --profile milvus up -d 后再改 true
