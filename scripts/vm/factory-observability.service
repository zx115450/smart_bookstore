[Unit]
Description=Start Prometheus and Grafana (factory-observability)
After=docker.service network-online.target milvus-stack.service
Wants=network-online.target
Requires=docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/start-observability-stack.sh
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
